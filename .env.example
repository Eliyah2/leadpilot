# ════════════════════════════════════════════════════════════
#  LeadPilot - voorbeeld van environment variables
# ════════════════════════════════════════════════════════════
# Zet GEOAPIFY_API_KEY lokaal in .env.local; voeg optionele instellingen zo nodig toe.
# Zet deze variabelen in Vercel via: Project -> Settings -> Environment Variables.
# Committeer .env NOOIT. Zet geen echte sleutels in dit bestand.

# ── Optionele bronnen voor echte leads ───────────────────────
# Aanbevolen zonder bankpas: gratis Geoapify-sleutel via https://myprojects.geoapify.com/
# Zet de sleutel alleen in deze serveromgeving (of in Vercel), nooit in de browser.
GEOAPIFY_API_KEY=
# Maximaal aantal Geoapify-aanvragen per dag in LeadPilot (standaard 50).
MAX_GEOAPIFY_REQUESTS_PER_DAY=50
# Alternatief: Google Places vereist facturering/betaalmethode in Google Cloud.
GOOGLE_PLACES_API_KEY=

# ── Aanbevolen: toegangsbeveiliging ─────────────────────────
# Is deze leeg, dan is de app openbaar en kan iedereen je API-tegoed
# verbruiken. Stel altijd een wachtwoord in op productie.
APP_PASSWORD=

# ── Optioneel: limieten (kostenbeheersing) ──────────────────
# Maximaal aantal Google Places-zoekopdrachten per dag (standaard 100).
MAX_SEARCHES_PER_DAY=100
# Maximaal aantal website-audits per dag (standaard 200).
MAX_AUDITS_PER_DAY=200
# Cache-duur van zoekresultaten in seconden (standaard 86400 = 24 uur).
SEARCH_CACHE_TTL_SECONDS=86400

# ── Optioneel: synchroniseren tussen apparaten ──────────────
# Vul beide in om Instellingen + pipeline in Redis te bewaren in plaats van
# alleen in localStorage. Werkt met Upstash Redis of Vercel KV
# (Vercel KV levert precies deze twee variabelen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optioneel: audits toestaan op dezelfde host als de app (SSRF-bescherming) ──
# Laat leeg in productie. Alleen handig tijdens lokaal ontwikkelen.
ALLOW_PRIVATE_AUDIT_TARGETS=false
