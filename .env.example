# Copy to .env. Never commit .env (it is gitignored).

# Network: 127.0.0.1 = this PC only. 0.0.0.0 = also reachable from phones on the same Wi-Fi.
HOST=127.0.0.1
SF_PORT=4400

# Where databases, renders and secrets live (relative to the project root).
STORAGE_DIR=storage

# Optional: fixed server secret for token encryption (>= 16 chars). If unset, one is generated
# into storage/.secret on first start.
# SF_SECRET=

# Optional public base URL (used when the app is reached through a tunnel).
# PUBLIC_URL=

# Optional: cap concurrent background jobs.
# JOB_CONCURRENCY=2

# Optional: allow tests to call external services (default off).
# SF_ALLOW_NETWORK=0
